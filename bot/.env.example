# OpenRanch assistant configuration.
#
#   cp .env.example /opt/openranch-bot/.env
#   chmod 600 /opt/openranch-bot/.env
#
# This file holds every secret the assistant has. It is gitignored and must
# never be committed: the bot token lets anyone speak as your bot, and the API
# key spends your Anthropic credit.

# From @BotFather.
TELEGRAM_BOT_TOKEN=CHANGE_ME

# From console.anthropic.com.
ANTHROPIC_API_KEY=CHANGE_ME

# Shared with the dashboard's BOT_SHARED_SECRET. Gates the three endpoints that
# act without a customer token (resolve, bind-next, briefing-list), which is how
# a chat gets bound in the first place. Generate with:
#     openssl rand -hex 24
BOT_SHARED_SECRET=CHANGE_ME

# The MCP server. Loopback only -- it is authorised by the token in each call,
# so anything that can reach the port can act as any customer whose token it
# knows. The server refuses to bind a non-loopback address.
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_URL=http://127.0.0.1:8765/mcp

# Your dashboard.
OPENRANCH_API_BASE=https://dashboard.example.com/api/v1

# Any current Claude model. Sonnet is a good fit here: the work is short
# conversational turns over a handful of tools.
CLAUDE_MODEL=claude-sonnet-4-6

# Voice in (faster-whisper) and out (Piper). "small" is the useful floor on CPU;
# expect roughly 15-20s for a short clip on two cores.
WHISPER_MODEL=small
WHISPER_COMPUTE=int8
PIPER_VOICE=/opt/openranch-bot/voices/en_US-lessac-medium.onnx

BRIEFING_TZ=America/Los_Angeles
